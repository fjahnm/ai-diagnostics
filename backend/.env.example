NODE_ENV=development
HOST=127.0.0.1
PORT=3333
DATABASE_URL=postgresql://diagnostics:diagnostics_local_only@127.0.0.1:5434/ai_diagnostics
INGEST_API_KEY=replace-with-a-long-random-string-at-least-24-characters
LLM_PROVIDER=groq
LLM_TIMEOUT_MS=18000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_COMPLETION_TOKENS=4096
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Connector credentials: 32 random bytes in base64 (generate locally before using secrets).
CONNECTOR_ENCRYPTION_KEY=
# Allow localhost and internal networks only for trusted local development.
CONNECTOR_ALLOW_PRIVATE_HOSTS=false
